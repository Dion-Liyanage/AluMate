MAIL_FROM=


# AI Assistant (Google Gemini free tier — get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Messages allowed per 10 minutes (anonymous visitors / logged-in customers)
AI_CHAT_ANON_LIMIT=15
AI_CHAT_USER_LIMIT=40
