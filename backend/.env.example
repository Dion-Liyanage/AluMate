# Comma-separated list of allowed frontend origins (CORS + Socket.io)
# e.g. http://localhost:3000,https://alumate.vercel.app
FRONTEND_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
